{
  "Database": {
    "Host": "localhost",
    "Port": 5432,
    "Name": "invoice_keeper",
    "Username": "postgres",
    "MigrateOnStartup": false,
    "SeedOnStartup": true
  },
  "JWT": {
    "Issuer": "InvoiceKeeperBackend",
    "Audience": "InvoiceKeeperClients",
    "ExpiryInHours": 24
  },
  "AdminSeed": {
    "Username": "admin"
  },
  "BotAuth": {
    "ServiceName": "InvoiceKeeperTelegramBot"
  },
  "HttpsRedirection": {
    "Enabled": true
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "None"
      }
    }
  },
  "AllowedHosts": "*"
}
