{
  "Database": {
    "Host": "localhost",
    "Port": 5432,
    "Name": "invoice_keeper",
    "Username": "postgres",
    "MigrateOnStartup": false,
    "SeedOnStartup": false
  },
  "JWT": {
    "Issuer": "InvoiceKeeperBackend",
    "Audience": "InvoiceKeeperClients",
    "ExpiryInHours": 24
  },
  "AdminSeed": {
    "Username": "admin"
  },
  "BotAuth": {
    "ServiceName": "InvoiceKeeperTelegramBot"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
