# Скопируйте этот файл в .env и задайте собственный надёжный пароль:
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
# Файл .env указан в .gitignore и в репозиторий не попадает.

# Пароль пользователя PostgreSQL (обязательно поменяйте)
POSTGRES_PASSWORD=change-me-please

# Параметры базы данных
POSTGRES_DB=invoice_keeper
POSTGRES_USER=postgres

# Порт PostgreSQL, проброшенный на хост
POSTGRES_PORT=5432

# Порт backend-приложения на хосте
BACKEND_PORT=8080

# Окружение ASP.NET Core: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# Секрет для подписи JWT (не менее 32 символов, обязательно поменяйте)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Учётная запись администратора, создаётся при старте, если её ещё нет
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Токен сервисного доступа для Telegram-бота (заголовок X-Service-Token)
BOT_SERVICE_TOKEN=change-me-please

# Единый часовой пояс для всего приложения (например: Europe/Minsk, Europe/Moscow)
APP_TIMEZONE=Europe/Minsk