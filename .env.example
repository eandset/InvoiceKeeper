# Скопируйте этот файл в .env и задайте собственный надёжный пароль:
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
# Файл .env указан в .gitignore и в репозиторий не попадает.

# Пароль пользователя PostgreSQL (обязательно поменяйте)
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Параметры базы данных
POSTGRES_DB=invoice_keeper
POSTGRES_USER=postgres

# Порт PostgreSQL, проброшенный на хост
POSTGRES_PORT=5432

# Порт backend-приложения на хосте (обязательный параметр)
BACKEND_PORT=8080

# Окружение ASP.NET Core: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# Backend auth

# Секрет для подписи JWT (не менее 32 символов, обязательно поменяйте)
JWT_SECRET=your_super_secret_jwt_key_with_at_least_32_characters_long

# Учётная запись администратора, создаётся при старте, если её ещё нет
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here

# Токен сервисного доступа для Telegram-бота (заголовок X-Service-Token)
BOT_SERVICE_TOKEN=your_bot_service_token_here

# Единый часовой пояс для всего приложения
APP_TIMEZONE=Europe/Minsk

# Токен вашего Telegram-бота от @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_12345678

# Адрес бэкенда для внешних сервисов / локального тестирования
API_URL=http://localhost:5164/api/v1

# ID чата для уведомлений (узнаете через /start в боте)
TARGET_CHAT_ID=123456789

# Ссылка на Telegram-бота для фронтенда
VITE_BOT_URL=https://t.me/your_bot_username

# Необязательные параметры (можно оставить по умолчанию)
CRON_SCHEDULE_HOUR=9
CRON_SCHEDULE_MINUTE=0
REMINDER_LEAD_DAYS=3