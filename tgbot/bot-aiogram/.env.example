# Токен Telegram-бота от @BotFather (Обязательно)
BOT_TOKEN=your_telegram_bot_token_here

# Адрес бэкенда API (Обязательно)
API_URL=http://localhost:5164/api/v1

# Сервисный токен (передается в заголовке X-Service-Token)
BOT_SERVICE_TOKEN=your_service_token_here

# ID чата/канала, куда будут приходить фоновые уведомления
TARGET_CHAT_ID=123456789

# Настройки планировщика (Необязательно)
CRON_SCHEDULE_HOUR=9       # Час запуска ежедневных напоминаний (0-23)
CRON_SCHEDULE_MINUTE=0     # Минута запуска ежедневных напоминаний (0-59)
REMINDER_LEAD_DAYS=3       # За сколько дней искать платежи для напоминания